<%- include('partials/head', { title: 'Electroreck | Electrify Your Potential' }) %>
<%- include('partials/navbar') %>

<main>
  <!-- HERO SECTION -->
  <section class="hero" id="hero">
    <div class="container hero-container">
      <div class="hero-text-col">
        <h1 class="hero-title">Electroreck</h1>
        <p class="hero-tagline">Electrify your potential.</p>
        <p class="hero-description">
          A student-led engineering community at NIT Kurukshetra building, learning and competing together. 
          Workshops, competitions, and hands-on experiences built by students, for students.
        </p>

        <div class="hero-actions">
          <a href="#events" class="btn btn-primary" id="hero-btn-events">
            <span>Explore Events</span>
            <span>→</span>
          </a>
          <a href="#about" class="btn btn-secondary" id="hero-btn-about">
            <span>About Electroreck</span>
          </a>
        </div>

        <a href="#events" class="hero-scroll-cue" aria-label="Scroll to Upcoming Events">
          <span>Scroll to Events</span>
          <span class="cue-arrow">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- EVENTS SECTION -->
  <section class="section section-events" id="events">
    <div class="container">
      <div class="events-editorial-header">
        <div class="events-header-left">
          <span class="section-tag">EVENT SHOWCASE</span>
          <h2 class="section-title">UPCOMING EVENTS</h2>
          <p class="section-subtext">Discover what's happening at Electroreck and register online.</p>
        </div>
        <div class="events-header-right">
          <a href="#events" class="events-view-all-link" id="view-all-link">
            <span>VIEW ALL</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Filter Buttons -->
      <div class="events-filters" id="events-filters">
        <button class="filter-btn <%= (!activeCategory || activeCategory === 'All') ? 'active' : '' %>" data-category="All" onclick="filterEvents('All', this)">All</button>
        <button class="filter-btn <%= activeCategory === 'Technical' ? 'active' : '' %>" data-category="Technical" onclick="filterEvents('Technical', this)">Technical</button>
        <button class="filter-btn <%= activeCategory === 'Cultural' ? 'active' : '' %>" data-category="Cultural" onclick="filterEvents('Cultural', this)">Cultural</button>
        <button class="filter-btn <%= activeCategory === 'Sports' ? 'active' : '' %>" data-category="Sports" onclick="filterEvents('Sports', this)">Sports</button>
      </div>

      <!-- Dynamic Event Cards Grid (Server-Rendered with EJS) -->
      <div class="event-grid" id="event-grid">
        <% if (events && events.length > 0) { %>
          <% events.forEach(event => { 
               const isClosed = event.registrationOpen === false;
               const isFull = (event.registrationCount || 0) >= (event.capacity || 100);
               const iconMap = { 'Technical': '⚡', 'Cultural': '🎭', 'Sports': '🏆' };
               const icon = iconMap[event.category] || '⚡';
          %>
            <article class="event-card" id="event-<%= event._id %>" data-category="<%= event.category %>">
              <a href="/event/<%= event._id %>" class="card-media" title="View details for <%= event.title %>">
                <img 
                  src="<%= event.image || '/assets/events/technical.jpg' %>" 
                  alt="<%= event.title %>" 
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/assets/events/technical.jpg';"
                />
                <span class="card-category-badge"><%= icon %> <%= event.category %></span>
              </a>

              <div class="card-body">
                <h3 class="card-title">
                  <a href="/event/<%= event._id %>" style="color: inherit; text-decoration: none;"><%= event.title %></a>
                </h3>
                <p class="card-desc"><%= event.description || event.tagline || '' %></p>

                <ul class="card-meta-list">
                  <li class="card-meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span><%= event.date %></span>
                  </li>
                  <li class="card-meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span><%= event.time %></span>
                  </li>
                  <li class="card-meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span><%= event.venue %></span>
                  </li>
                </ul>

                <div class="card-status-box">
                  <span class="status-indicator <%= isClosed ? 'status-closed' : isFull ? 'status-full' : 'status-open' %>">
                    <span class="status-dot"></span>
                    <%= isClosed ? 'Registrations Closed' : isFull ? 'Capacity Reached' : 'Registrations Open' %>
                  </span>
                </div>

                <div class="card-footer">
                  <a href="/event/<%= event._id %>" class="btn-card-details">
                    <span>Details</span>
                    <span>→</span>
                  </a>
                  <% if (isClosed) { %>
                    <span class="btn-card-register disabled">Closed</span>
                  <% } else if (isFull) { %>
                    <span class="btn-card-register disabled">Full</span>
                  <% } else { %>
                    <a href="/register/<%= event._id %>" class="btn-card-register">Register</a>
                  <% } %>
                </div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: var(--text-muted);">
            <h3>No events found</h3>
            <p>Check back soon or select a different category filter.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section class="section section-dark" id="about">
    <div class="container">
      <div class="about-wrapper">
        <div class="about-content-left">
          <span class="section-tag">ABOUT US</span>
          <h2>Where Technology Meets Curiosity</h2>
          <p class="about-text">
            Electroreck is the official electronics and technical club committed to empowering students through practical 
            engineering, collaborative innovation, and real-world problem solving.
          </p>
          <p class="about-text">
            From embedded systems and robotics to sound-circuit synthesis and high-energy prototyping challenges, 
            we foster an environment where ideas transform into tangible impact.
          </p>

          <div class="about-highlights">
            <div class="highlight-box">
              <div class="highlight-title text-gold">Hands-on Labs</div>
              <div class="highlight-desc">Access to microcontrollers, sensors, and rapid prototyping equipment.</div>
            </div>
            <div class="highlight-box">
              <div class="highlight-title text-gold">Mentorship</div>
              <div class="highlight-desc">Peer-to-peer technical guidance from experienced senior engineers.</div>
            </div>
          </div>
        </div>

        <div class="about-visual-right">
          <img src="/assets/logo/electrorec-logo.png" alt="Electroreck Emblem" class="about-logo-center" onerror="this.src='/assets/logo/electrorec-logo.svg'" />
          <div class="about-motto">ELECTRIFY YOUR POTENTIAL</div>
          <p style="font-size:0.85rem; color:var(--text-muted); margin-top:8px;">
            National Institute of Technology Kurukshetra
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY JOIN US SECTION -->
  <section class="section" id="why-electrorec">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">COMMUNITY & IMPACT</span>
        <h2 class="section-title">Why Electroreck?</h2>
        <p class="section-desc">
          A cohesive platform designed to accelerate your technical skills and collaborative network.
        </p>
      </div>

      <div class="why-grid">
        <div class="why-card">
          <span class="why-num">01</span>
          <h3 class="why-title">INNOVATION</h3>
          <p class="why-desc">
            Explore emerging hardware, Internet of Things, embedded firmware, and modern web architectures by building real projects.
          </p>
        </div>

        <div class="why-card">
          <span class="why-num">02</span>
          <h3 class="why-title">COMMUNITY</h3>
          <p class="why-desc">
            Connect with fellow developers, creators, and tinkerers who share an unwavering passion for engineering excellence.
          </p>
        </div>

        <div class="why-card">
          <span class="why-num">03</span>
          <h3 class="why-title">EXPERIENCE</h3>
          <p class="why-desc">
            Participate in hackathons, organize campus-wide technical symposiums, and build portfolio-worthy leadership experience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================
       FAQ SECTION
  ===================== -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header faq-header">
        <span class="section-tag">COMMON QUERIES</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-desc">
          Got questions about event participation, registration passes, eligibility, or joining the club? Find quick answers below.
        </p>
      </div>

      <!-- FAQ Category Filter Pills -->
      <div class="faq-category-pills">
        <button type="button" class="faq-cat-pill active" data-filter="all">All Questions</button>
        <button type="button" class="faq-cat-pill" data-filter="registration">Registrations & Passes</button>
        <button type="button" class="faq-cat-pill" data-filter="eligibility">Eligibility & Entry</button>
        <button type="button" class="faq-cat-pill" data-filter="certificates">Certificates & Prizes</button>
        <button type="button" class="faq-cat-pill" data-filter="club">Club Induction</button>
      </div>

      <!-- FAQ Accordion Container -->
      <div class="faq-container">
        
        <!-- FAQ Item 1 -->
        <div class="faq-item active" data-category="eligibility">
          <button type="button" class="faq-question-btn" aria-expanded="true">
            <span>Who is eligible to participate in ELECTRORECK events?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                All undergraduate and postgraduate students of <strong>NIT Kurukshetra</strong> across all branches (ECE, CSE, EE, Mechanical, Civil, etc.) and all academic years are eligible to participate in our workshops, guest lectures, and intra-college showcases.
              </p>
              <p>
                Selected flagship hackathons, national technical symposiums, and tech-sports championships are also open to registered university students across India.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 2 -->
        <div class="faq-item" data-category="registration">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Is there any registration fee required to attend?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                The vast majority of our workshops, bootcamps, and introductory hardware showcases are completely <strong>free of charge</strong> for all students.
              </p>
              <p>
                For specialized hackathons or intensive hands-on workshops requiring dedicated hardware kits (e.g., microcontrollers, sensors, breadboards) or external industry certifications, any nominal material fee is explicitly stated on the event details page.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 3 -->
        <div class="faq-item" data-category="registration">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>How do I receive my registration confirmation and entry pass?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                As soon as you submit the online registration form, a verified digital <strong>Registration Pass</strong> is generated on your screen with a unique tracking code (such as <code>ER-2026-00101</code>).
              </p>
              <p>
                You can save a screenshot or print this ticket directly. Presenting your unique Pass ID at the registration desk ensures rapid check-in on the day of the event.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 4 -->
        <div class="faq-item" data-category="registration">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Can I register for multiple events during the club calendar?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                Yes! You are welcome to register for multiple events across our Technical Workshops, Cultural Showcases, and Tech-Sports championships, provided their schedules do not overlap.
              </p>
              <p>
                Each event manages its own seating quota independently, so please ensure you submit a registration for each individual session you wish to attend.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 5 -->
        <div class="faq-item" data-category="eligibility">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Do I need prior hardware or coding experience to join?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                Not at all! ELECTRORECK workshops cater to all skill levels. Our introductory sessions start from scratch with step-by-step guidance on breadboarding, microcontroller programming, and circuit debugging.
              </p>
              <p>
                Senior club coordinators and student mentors will be by your side to guide you through every laboratory experiment.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 6 -->
        <div class="faq-item" data-category="certificates">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>Will attendees receive verified certificates and prizes?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                Yes. All participants who attend the sessions and verify their attendance receive an official digital <strong>Certificate of Participation</strong> issued by ELECTRORECK, NIT Kurukshetra.
              </p>
              <p>
                Winners and top performers in hackathons and competitive tracks receive <strong>Certificates of Merit</strong>, trophies, tech gear, and cash awards from our prize pools.
              </p>
            </div>
          </div>
        </div>

        <!-- FAQ Item 7 -->
        <div class="faq-item" data-category="club">
          <button type="button" class="faq-question-btn" aria-expanded="false">
            <span>How can I join the ELECTRORECK core team or coordinator committee?</span>
            <div class="faq-icon-wrapper">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </button>
          <div class="faq-answer-collapse">
            <div class="faq-answer-content">
              <p>
                ELECTRORECK conducts annual inductions at the beginning of each semester for passionate first- and second-year students.
              </p>
              <p>
                We recruit across several specialized wings: <strong>Hardware & IoT</strong>, <strong>Web & App Engineering</strong>, <strong>Event Management & Logistics</strong>, <strong>Creative Design & Media</strong>, and <strong>Corporate Sponsorship</strong>. Keep an eye on our portal and campus notice boards for audition announcements!
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- FAQ Help Assistance Box -->
      <div class="faq-help-box">
        <div class="faq-help-text">
          Have a query that isn't answered here? Reach out to our organizing team directly at 
          <a href="mailto:contact@electroreck.club" class="faq-help-link">contact@electroreck.club</a>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  // Dynamic client-side category filtering
  function filterEvents(category, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const cards = document.querySelectorAll('.event-card');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (category === 'All' || cardCat.toLowerCase() === category.toLowerCase()) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

<%- include('partials/footer') %>
