# Server Environment Configuration
PORT=1234
NODE_ENV=production

# MongoDB Connection String
# For local development: mongodb://127.0.0.1:27017/electroreck
# For Vercel production: Provide a MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/electroreck)
# Note: If no MONGODB_URI is provided, the platform automatically runs on its built-in in-memory fallback store!
MONGODB_URI=

# JWT Secret for Organizer Authentication
JWT_SECRET=electroreck_super_secret_jwt_key_2026

# Default Club Administrator Credentials
ADMIN_EMAIL=admin@electrorec.club
ADMIN_PASSWORD=electrorec2026
