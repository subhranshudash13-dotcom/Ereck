<%- include('partials/head', { title: (event ? 'Register for ' + event.title + ' | Electroreck' : 'Event Registration | Electroreck') }) %>
<%- include('partials/navbar') %>

<style>
  .reg-page-section {
    padding: 120px 0 90px;
  }
  .reg-breadcrumb-bar {
    margin-bottom: 24px;
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .reg-breadcrumb-bar a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .reg-breadcrumb-bar a:hover {
    color: var(--gold);
  }
  .reg-breadcrumb-bar span.active {
    color: var(--white);
    font-weight: 500;
  }
  .reg-layout {
    display: grid;
    grid-template-columns: 0.95fr 1.35fr;
    gap: 36px;
    align-items: flex-start;
  }
  .reg-event-summary-card {
    background: var(--black-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    position: sticky;
    top: 96px;
  }
  .reg-event-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    background: #111;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .reg-event-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .reg-event-category-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid var(--border);
    color: var(--gold);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
  }
  .reg-event-summary-content {
    padding: 24px;
  }
  .reg-event-summary-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 6px;
    color: var(--white);
  }
  .reg-event-summary-tagline {
    font-size: 0.88rem;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .reg-summary-meta-list {
    list-style: none;
    padding: 16px 0;
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .reg-summary-meta-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .reg-summary-meta-item svg {
    width: 16px;
    height: 16px;
    color: var(--gold);
    flex-shrink: 0;
  }
  .reg-event-notes {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin-bottom: 18px;
  }
  .reg-event-notes strong {
    color: var(--white);
    display: block;
    margin-bottom: 4px;
  }
  .reg-view-details-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--gold);
    text-decoration: none;
    font-weight: 500;
    transition: gap 0.2s ease;
  }
  .reg-view-details-link:hover {
    gap: 10px;
  }
  .reg-form-card {
    background: var(--black-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 36px 32px;
  }
  .reg-form-header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .reg-form-heading {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  .reg-form-subheading {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .reg-ticket-full {
    background: #080808;
    border: 1px solid rgba(234, 169, 67, 0.4);
    border-radius: var(--radius-md);
    padding: 30px;
    margin: 24px 0;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .reg-ticket-full::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .ticket-chip-pass {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(234, 169, 67, 0.1);
    border: 1px solid var(--gold);
    color: var(--gold);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }
  .ticket-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    text-align: left;
    font-size: 0.9rem;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .ticket-grid-item-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .ticket-grid-item-val {
    font-size: 0.92rem;
    color: var(--white);
    font-weight: 500;
  }
  .ticket-actions-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  @media (max-width: 900px) {
    .reg-layout {
      grid-template-columns: 1fr;
    }
    .reg-event-summary-card {
      position: static;
    }
    .reg-form-card {
      padding: 24px 20px;
    }
  }
</style>

<main>
  <section class="reg-page-section">
    <div class="container">
      
      <!-- Breadcrumb Bar -->
      <div class="reg-breadcrumb-bar">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/#events">Events</a>
        <span>/</span>
        <% if (event) { %>
          <a href="/event/<%= event._id %>"><%= event.title %></a>
        <% } else { %>
          <a href="/#events">Event Details</a>
        <% } %>
        <span>/</span>
        <span class="active">Registration</span>
      </div>

      <% if (!event) { %>
        <div class="reg-form-card" style="text-align: center; padding: 60px 20px;">
          <h2>No Event Selected</h2>
          <p style="color: var(--text-muted); margin: 16px 0 24px;">Please choose an event from our showcase to proceed with registration.</p>
          <a href="/#events" class="btn btn-primary">Browse Events →</a>
        </div>
      <% } else { 
           const isClosed = event.registrationOpen === false;
           const isFull = (event.registrationCount || 0) >= (event.capacity || 100);
           const iconMap = { 'Technical': '⚡', 'Cultural': '🎭', 'Sports': '🏆' };
           const icon = iconMap[event.category] || '⚡';
           const values = typeof formData !== 'undefined' ? formData : {};
      %>
        <div class="reg-layout">
          
          <!-- LEFT: Event Summary Sidebar -->
          <aside class="reg-event-summary-card">
            <div class="reg-event-image-wrap">
              <img 
                src="<%= event.image || '/assets/events/technical.jpg' %>" 
                alt="<%= event.title %>"
                onerror="this.onerror=null; this.src='/assets/events/technical.jpg';"
              />
              <span class="reg-event-category-badge"><%= icon %> <%= event.category.toUpperCase() %></span>
            </div>

            <div class="reg-event-summary-content">
              <h2 class="reg-event-summary-title"><%= event.title %></h2>
              <p class="reg-event-summary-tagline"><%= event.tagline || '' %></p>

              <ul class="reg-summary-meta-list">
                <li class="reg-summary-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span><%= event.date %></span>
                </li>
                <li class="reg-summary-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span><%= event.time %></span>
                </li>
                <li class="reg-summary-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span><%= event.venue %></span>
                </li>
              </ul>

              <div style="margin-bottom: 18px; padding: 12px 14px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.82rem; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center;">
                <span>Registration Status</span>
                <span class="status-indicator <%= isClosed ? 'status-closed' : isFull ? 'status-full' : 'status-open' %>">
                  <span class="status-dot"></span> 
                  <%= isClosed ? 'Closed' : isFull ? 'Full' : 'Open' %>
                </span>
              </div>

              <div class="reg-event-notes">
                <strong>📌 Registration Guidelines:</strong>
                • Free entry for all students.<br />
                • Bring your college student ID card on the event day.<br />
                • Verified certificates will be issued after attendance check.
              </div>

              <a href="/event/<%= event._id %>" class="reg-view-details-link">
                <span>View Full Event Description & Guidelines</span>
                <span>→</span>
              </a>
            </div>
          </aside>

          <!-- RIGHT: Student Registration Form & Confirmation -->
          <section class="reg-form-card">
            
            <% if (typeof registration !== 'undefined' && registration) { %>
              <!-- SUCCESS CONFIRMATION VIEW -->
              <div class="reg-success-view">
                <div style="text-align: center; margin-bottom: 24px;">
                  <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(85, 223, 140, 0.15); border: 1px solid #55df8c; color: #55df8c; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin: 0 auto 16px;">
                    ✓
                  </div>
                  <h1 class="reg-form-heading">Registration Confirmed!</h1>
                  <p class="reg-form-subheading">Your seat is reserved for <%= registration.eventTitle || event.title %>.</p>
                </div>

                <div class="reg-ticket-full">
                  <div class="ticket-chip-pass">
                    <span>⚡ <%= registration.registrationId %></span>
                  </div>

                  <div class="ticket-grid">
                    <div>
                      <div class="ticket-grid-item-label">Participant</div>
                      <div class="ticket-grid-item-val"><%= registration.name %></div>
                    </div>
                    <div>
                      <div class="ticket-grid-item-label">Roll Number</div>
                      <div class="ticket-grid-item-val"><%= registration.rollNumber %></div>
                    </div>
                    <div>
                      <div class="ticket-grid-item-label">Email</div>
                      <div class="ticket-grid-item-val"><%= registration.email %></div>
                    </div>
                    <div>
                      <div class="ticket-grid-item-label">Date & Time</div>
                      <div class="ticket-grid-item-val"><%= event.date %> (<%= event.time %>)</div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                      <div class="ticket-grid-item-label">Venue</div>
                      <div class="ticket-grid-item-val"><%= event.venue %></div>
                    </div>
                  </div>

                  <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">
                    Please present your registration ID or confirmation at the event venue desk for verification.
                  </p>
                </div>

                <div class="ticket-actions-bar">
                  <button type="button" class="btn btn-secondary" onclick="window.print()">
                    🖨️ Print Pass
                  </button>
                  <a href="/" class="btn btn-primary">
                    Return to Portal →
                  </a>
                </div>
              </div>

            <% } else { %>

              <!-- FORM VIEW -->
              <div id="page-form-view">
                <div class="reg-form-header">
                  <h1 class="reg-form-heading">Student Registration</h1>
                  <p class="reg-form-subheading">Fill in your academic information to secure your seat for this event.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                  <div class="form-alert error" style="display: block; margin-bottom: 20px;">
                    <%= error %>
                  </div>
                <% } %>

                <% if (isClosed || isFull) { %>
                  <div class="form-alert error" style="display: block; margin-bottom: 24px;">
                    <%= isClosed ? 'Registrations for this event have closed.' : 'This event has reached full capacity.' %>
                  </div>
                <% } %>

                <form id="standalone-reg-form" action="/register" method="POST">
                  <input type="hidden" id="form-event-id" name="eventId" value="<%= event._id %>" />

                  <!-- Full Name -->
                  <div class="form-group">
                    <label for="input-name" class="form-label">Full Name <span class="req">*</span></label>
                    <input 
                      type="text" 
                      id="input-name" 
                      name="name" 
                      class="form-input" 
                      placeholder="e.g. Rahul Sharma" 
                      value="<%= values.name || '' %>"
                      required 
                      <%= (isClosed || isFull) ? 'disabled' : '' %>
                    />
                  </div>

                  <!-- Email & Phone -->
                  <div class="form-row">
                    <div class="form-group">
                      <label for="input-email" class="form-label">Email Address <span class="req">*</span></label>
                      <input 
                        type="email" 
                        id="input-email" 
                        name="email" 
                        class="form-input" 
                        placeholder="name@domain.com" 
                        value="<%= values.email || '' %>"
                        required 
                        <%= (isClosed || isFull) ? 'disabled' : '' %>
                      />
                    </div>
                    <div class="form-group">
                      <label for="input-phone" class="form-label">Phone Number <span class="req">*</span></label>
                      <input 
                        type="tel" 
                        id="input-phone" 
                        name="phone" 
                        class="form-input" 
                        placeholder="e.g. 9876543210" 
                        value="<%= values.phone || '' %>"
                        required 
                        <%= (isClosed || isFull) ? 'disabled' : '' %>
                      />
                    </div>
                  </div>

                  <!-- Roll Number & Academic Year -->
                  <div class="form-row">
                    <div class="form-group">
                      <label for="input-roll" class="form-label">College Roll Number <span class="req">*</span></label>
                      <input 
                        type="text" 
                        id="input-roll" 
                        name="rollNumber" 
                        class="form-input" 
                        placeholder="e.g. 12213045" 
                        value="<%= values.rollNumber || '' %>"
                        required 
                        <%= (isClosed || isFull) ? 'disabled' : '' %>
                      />
                    </div>
                    <div class="form-group">
                      <label for="input-year" class="form-label">Academic Year <span class="req">*</span></label>
                      <select 
                        id="input-year" 
                        name="year" 
                        class="form-select" 
                        required 
                        <%= (isClosed || isFull) ? 'disabled' : '' %>
                      >
                        <option value="">Select Academic Year</option>
                        <option value="1st Year" <%= values.year === '1st Year' ? 'selected' : '' %>>1st Year (Freshman)</option>
                        <option value="2nd Year" <%= values.year === '2nd Year' ? 'selected' : '' %>>2nd Year (Sophomore)</option>
                        <option value="3rd Year" <%= values.year === '3rd Year' ? 'selected' : '' %>>3rd Year (Junior)</option>
                        <option value="4th Year" <%= values.year === '4th Year' ? 'selected' : '' %>>4th Year (Senior)</option>
                        <option value="Postgraduate" <%= values.year === 'Postgraduate' ? 'selected' : '' %>>Postgraduate / M.Tech / PhD</option>
                      </select>
                    </div>
                  </div>

                  <!-- Department / Branch -->
                  <div class="form-group">
                    <label for="input-branch" class="form-label">Department / Branch <span class="req">*</span></label>
                    <input 
                      type="text" 
                      id="input-branch" 
                      name="branch" 
                      class="form-input" 
                      placeholder="e.g. Electrical Engineering / Computer Engineering" 
                      value="<%= values.branch || '' %>"
                      required 
                      <%= (isClosed || isFull) ? 'disabled' : '' %>
                    />
                  </div>

                  <!-- College / Institution -->
                  <div class="form-group">
                    <label for="input-college" class="form-label">College / Institute</label>
                    <input 
                      type="text" 
                      id="input-college" 
                      name="college" 
                      class="form-input" 
                      value="<%= values.college || 'NIT Kurukshetra' %>" 
                      <%= (isClosed || isFull) ? 'disabled' : '' %>
                    />
                  </div>

                  <!-- Submit button -->
                  <div style="margin-top: 28px;">
                    <% if (isClosed || isFull) { %>
                      <button type="button" disabled class="btn btn-primary" style="width: 100%; opacity: 0.6; cursor: not-allowed;">
                        Registration Unavailable
                      </button>
                    <% } else { %>
                      <button type="submit" id="btn-submit-registration" class="btn btn-primary" style="width: 100%;">
                        <span>Confirm & Complete Registration</span>
                        <span>→</span>
                      </button>
                    <% } %>
                  </div>
                </form>
              </div>

            <% } %>

          </section>

        </div>
      <% } %>

    </div>
  </section>
</main>

<%- include('partials/footer') %>
