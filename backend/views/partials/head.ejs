<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Electroreck — The Premier University Technical Club Event Management Platform. Electrify Your Potential with workshops, cultural showcases, and tech-sports competitions." />
  <meta name="keywords" content="Electroreck, University Club, Technical Events, Engineering, IoT, Workshops, NIT Kurukshetra" />
  <title><%= typeof title !== 'undefined' ? title : 'Electroreck | Electrify Your Potential' %></title>

  <!-- Favicon / Logo -->
  <link rel="icon" type="image/png" href="/assets/logo/electrorec-logo.png" />

  <!-- Google Fonts: Space Grotesk & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />

  <!-- Pre-paint Theme Initializer to prevent flash -->
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('electrorec_theme');
        document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
      } catch (e) {}
    })();
  </script>
</head>
<body>
